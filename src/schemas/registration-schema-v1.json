{
    "meta": {
        "id": "schema-registration-v1",
        "version": "1.0.0",
        "description": "Schema per il modulo di iscrizione Renga Treffen 2026"
    },
    "fields": [
        {
            "name": "nome",
            "label": "Nome",
            "type": "text",
            "required": true,
            "placeholder": "Mario"
        },
        {
            "name": "cognome",
            "label": "Cognome",
            "type": "text",
            "required": true,
            "placeholder": "Rossi"
        },
        {
            "name": "email",
            "label": "Email",
            "type": "email",
            "required": true,
            "placeholder": "mario.rossi@example.com"
        },
        {
            "name": "telefono",
            "label": "Telefono",
            "type": "tel",
            "required": true,
            "placeholder": "+39 333 1234567"
        },
        {
            "name": "partner_name",
            "label": "Partner (Farò coppia con)",
            "type": "text",
            "required": false,
            "placeholder": "Nome del compagno di squadra"
        }
    ]
}