{
    "meta": {
        "id": "blitz-registration-schema",
        "version": "1.2.0",
        "name": "Super Registration Form 2026",
        "context": "Renga Treffen 2026"
    },
    "sections": [
        {
            "id": "mcps",
            "title": "Affiliazione Moto Club Polizia di Stato",
            "fields": [
                {
                    "name": "is_mcps_member",
                    "label": "Sei iscritto al Moto Club Polizia di Stato?",
                    "type": "radio",
                    "options": [
                        "SI",
                        "NO"
                    ],
                    "required": true
                },
                {
                    "name": "mcps_delegation",
                    "label": "Se si con quale delegazione?",
                    "type": "text",
                    "required": false,
                    "condition": {
                        "field": "is_mcps_member",
                        "value": "SI"
                    }
                }
            ]
        },
        {
            "id": "formula",
            "title": "Formula di Partecipazione",
            "fields": [
                {
                    "name": "formula_partecipazione",
                    "label": "Scegli la tua formula",
                    "type": "radio",
                    "options": [
                        "Caccia_MCPS",
                        "Caccia_NON_MCPS",
                        "Discovery",
                        "4x4"
                    ],
                    "required": true
                },
                {
                    "name": "passeggeri_4x4",
                    "label": "Numero Passeggeri Extra (solo 4x4)",
                    "type": "number",
                    "required": false,
                    "condition": {
                        "field": "formula_partecipazione",
                        "value": "4x4"
                    }
                },
                {
                    "name": "pranzo_accompagnatori",
                    "label": "Accompagnatori solo pranzo (€ 30/cad)",
                    "type": "number",
                    "required": false
                },
                {
                    "name": "importo_dovuto",
                    "label": "Totale Calcolato",
                    "type": "number",
                    "readonly": true
                }
            ]
        },
        {
            "id": "team",
            "title": "Dati Team & Moto",
            "fields": [
                {
                    "name": "team_name",
                    "label": "Nome del Team",
                    "type": "text",
                    "required": true,
                    "placeholder": "Inserisci il nome del tuo team"
                },
                {
                    "name": "moto_details",
                    "label": "Moto (Marca, modello, cilindrata e targa)",
                    "type": "text",
                    "required": true,
                    "placeholder": "Es: KTM 890 Adventure, 889cc, AA123BB"
                },
                {
                    "name": "team_role",
                    "label": "Il tuo ruolo nel Team",
                    "type": "radio",
                    "options": [
                        "Capitano",
                        "partner"
                    ],
                    "required": true
                }
            ]
        },
        {
            "id": "personal",
            "title": "Dati Personali Pilota (Tu)",
            "fields": [
                {
                    "name": "cognome",
                    "label": "Cognome",
                    "type": "text",
                    "required": true
                },
                {
                    "name": "nome",
                    "label": "Nome",
                    "type": "text",
                    "required": true
                },
                {
                    "name": "codice_fiscale",
                    "label": "Codice Fiscale",
                    "type": "text",
                    "required": true
                },
                {
                    "name": "citta_nascita",
                    "label": "Città di Nascita",
                    "type": "text",
                    "required": true
                },
                {
                    "name": "citta_residenza",
                    "label": "Città di Residenza",
                    "type": "text",
                    "required": true
                },
                {
                    "name": "via_residenza",
                    "label": "Via di residenza",
                    "type": "text",
                    "required": true
                },
                {
                    "name": "civico_residenza",
                    "label": "Civico di Residenza",
                    "type": "text",
                    "required": true
                },
                {
                    "name": "cap_residenza",
                    "label": "Cap di residenza",
                    "type": "text",
                    "required": true
                },
                {
                    "name": "telefono",
                    "label": "Telefono Cellulare",
                    "type": "tel",
                    "required": true
                },
                {
                    "name": "email",
                    "label": "Email",
                    "type": "email",
                    "required": true
                }
            ]
        },
        {
            "id": "partner",
            "title": "Dati Secondo Componente (Partner)",
            "fields": [
                {
                    "name": "secondo_cognome",
                    "label": "Cognome del secondo componente",
                    "type": "text",
                    "required": false
                },
                {
                    "name": "secondo_nome",
                    "label": "Nome del secondo componente",
                    "type": "text",
                    "required": false
                },
                {
                    "name": "secondo_cellulare",
                    "label": "Cellulare del secondo componente (Link Piloti)",
                    "type": "tel",
                    "required": false,
                    "help": "Questo dato verrà utilizzato per collegare i due piloti"
                }
            ]
        },
        {
            "id": "awareness",
            "title": "Consapevolezza & Regolamento",
            "fields": [
                {
                    "name": "has_roadbook_skill",
                    "label": "Uno dei componenti possiede e sa utilizzare lo strumento di lettura del Roadbook Digitale?",
                    "type": "radio",
                    "options": [
                        "SI",
                        "NO"
                    ],
                    "required": true
                },
                {
                    "name": "understand_treasure_hunt",
                    "label": "Hai compreso che si tratta di una caccia al tesoro su strade a fondo naturale?",
                    "type": "radio",
                    "options": [
                        "SI",
                        "NO"
                    ],
                    "required": true
                },
                {
                    "name": "understand_knobby_tires",
                    "label": "Hai compreso che è necessario montare ruote tassellate?",
                    "type": "radio",
                    "options": [
                        "SI",
                        "NO"
                    ],
                    "required": true
                },
                {
                    "name": "understand_team_of_2",
                    "label": "Hai compreso che il TEAM è composto da 2 Piloti?",
                    "type": "radio",
                    "options": [
                        "SI",
                        "NO"
                    ],
                    "required": true
                },
                {
                    "name": "understand_donation_no_refund",
                    "label": "Hai compreso che la quota versata è una donazione e non può essere restituita?",
                    "type": "radio",
                    "options": [
                        "SI",
                        "NO"
                    ],
                    "required": true
                },
                {
                    "name": "understand_rain_or_shine",
                    "label": "Hai compreso che l'evento si svolgerà anche in caso di pioggia?",
                    "type": "radio",
                    "options": [
                        "SI",
                        "NO"
                    ],
                    "required": true
                }
            ]
        },
        {
            "id": "media",
            "title": "Privacy & Profilo Pilota",
            "fields": [
                {
                    "name": "authorize_media",
                    "label": "Autorizzi alla pubblicazione di foto/video sul sito e sui social?",
                    "type": "radio",
                    "options": [
                        "SI",
                        "NO"
                    ],
                    "required": true
                },
                {
                    "name": "authorize_pilot_profile",
                    "label": "Autorizzi a pubblicare nel sito la tua foto e un breve CV motociclistico?",
                    "type": "radio",
                    "options": [
                        "SI",
                        "NO"
                    ],
                    "required": true
                },
                {
                    "name": "pilot_photo",
                    "label": "Carica la tua foto profilo",
                    "type": "file",
                    "required": false,
                    "condition": {
                        "field": "authorize_pilot_profile",
                        "value": "SI"
                    }
                },
                {
                    "name": "pilot_bio",
                    "label": "Raccontaci di te (max 500 caratteri)",
                    "type": "textarea",
                    "required": false,
                    "max_length": 500,
                    "placeholder": "La tua storia motociclistica...",
                    "condition": {
                        "field": "authorize_pilot_profile",
                        "value": "SI"
                    }
                }
            ]
        },
        {
            "id": "fango",
            "title": "Associazione Fango Tours",
            "fields": [
                {
                    "name": "is_fango_tours_member",
                    "label": "Sei già tesserato con Fango Tours?",
                    "type": "radio",
                    "options": [
                        "SI",
                        "NO"
                    ],
                    "required": false
                },
                {
                    "name": "request_fango_tours_membership",
                    "label": "Dichiaro di volermi tesserare a Fango Tours (importo compreso nell'iscrizione)",
                    "type": "radio",
                    "options": [
                        "SI",
                        "NO"
                    ],
                    "required": true
                },
                {
                    "name": "accept_fango_insurance",
                    "label": "Dichiaro di aver letto le condizioni della polizza assicurativa Fango Tours",
                    "type": "radio",
                    "options": [
                        "SI",
                        "NO"
                    ],
                    "required": true
                }
            ]
        },
        {
            "id": "health",
            "title": "Alimentazione & Emergenze",
            "fields": [
                {
                    "name": "food_preferences",
                    "label": "Preferenze alimentari o allergie",
                    "type": "textarea",
                    "required": false
                },
                {
                    "name": "emergency_contact_phone",
                    "label": "Numero di contatto in caso di problemi",
                    "type": "tel",
                    "required": false
                },
                {
                    "name": "emergency_contact_info",
                    "label": "Grado di parentela, nome e cognome del contatto",
                    "type": "textarea",
                    "required": false
                }
            ]
        },
        {
            "id": "final",
            "title": "Conferma Finale",
            "fields": [
                {
                    "name": "accept_regulation",
                    "label": "Dichiaro di aver letto e compreso il regolamento",
                    "type": "radio",
                    "options": [
                        "SI",
                        "NO"
                    ],
                    "required": true
                }
            ]
        }
    ]
}